{
  "version": 1,
  "author": "Chinmay Dubey",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": -120,
      "left": -230,
      "attrs": { "lux": "1000" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": -40,
      "left": 230,
      "attrs": { "color": "yellow" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 70,
      "left": 160,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 190,
      "left": 190,
      "attrs": { "color": "red", "label": "drop network" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "ldr1:VCC", "esp:3V3", "red", [ "h0" ] ],
    [ "ldr1:GND", "esp:GND.1", "black", [ "h0" ] ],
    [ "ldr1:AO", "esp:34", "green", [ "h0" ] ],
    [ "esp:18", "r1:1", "orange", [ "h0" ] ],
    [ "r1:2", "led1:A", "orange", [ "v0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ],
    [ "btn1:1.l", "esp:4", "blue", [ "h0" ] ],
    [ "btn1:2.l", "esp:GND.2", "black", [ "h0" ] ]
  ],
  "dependencies": {}
}
